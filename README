# Project dependencies:
- CMake for building libraries.
- ncurses
- C++20
- Ninja

# To make build files:
- cmake -B build -G Ninja

# To make main executable:
- cmake --build build

# To run program:
- ./build/main

# To build and run:
- ./brun

# To make sure clangd LSP works:
- ln -sf build/compile_commands.json compile_commands.json
